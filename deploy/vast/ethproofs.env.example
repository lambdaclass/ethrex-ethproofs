# Copy to ~/.ethproofs.env and chmod 600 it. Never commit the real file.
#
# Ethereum mainnet JSON-RPC endpoint. MUST support debug_executionWitness
# (input generation depends on it). Ask the team for the production endpoint.
ETH_RPC_URL=

# EthProofs API key (submissions to ethproofs.org). Ask the team / ethproofs dashboard.
# Without it the app is in local-test mode — and on this branch it currently crashes
# on every 100th block (see deploy/vast/README.md "Known issues").
ETHPROOFS_API_KEY=

# Optional overrides (defaults shown are the production values used by relaunch-dual-prover.sh)
# ETHPROOFS_RPC_URL=https://ethproofs.org/api/v0
# ZISK_CLUSTER_ID=3
# AIRBENDER_CLUSTER_ID=4
# PROVING_TIMEOUT_SECONDS=1200
